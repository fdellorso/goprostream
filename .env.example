# GoPro Streaming Server — Configurazione
# Copia in .env e modifica i valori

# ─── GoPro ──────────────────────────────────────────────────

# IP della GoPro (default rete WiFi Direct)
GOPRO_IP=10.5.5.9

# SSID della rete WiFi Direct della GoPro
# Dopo reset: GP<numero_seriale> (es. GP26479007)
# Dopo pairing: GOPRO-BP-<numeri>
GOPRO_SSID=GP26479007

# Password WiFi GoPro (default)
GOPRO_PASS=goprohero

# ─── Streaming ──────────────────────────────────────────────

# URL RTMP di destinazione (usato dal container python)
RTMP_URL=rtmp://localhost:1935/live/gopro

# Porta UDP dello stream GoPro
UDP_PORT=8554

# Intervallo KeepAlive in secondi (la GoPro disconnette dopo ~10s)
KEEPALIVE_INTERVAL=8

# ─── Porte ──────────────────────────────────────────────────

# Porta HTTP per HLS (nginx)
HLS_PORT=8080

# Porta RTMP (nginx)
RTMP_PORT=1935
