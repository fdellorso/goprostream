FROM docker.io/library/python:3.11-slim

# FFmpeg è necessario per la conversione UDP→RTMP
RUN apt-get update && \
    apt-get install -y --no-install-recommends ffmpeg curl && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Installa dipendenze Python
COPY python/Pipfile python/Pipfile.lock* ./
RUN pip install --no-cache-dir pipenv && \
    (pipenv requirements > requirements.txt 2>/dev/null && \
     pip install --no-cache-dir -r requirements.txt || \
     pip install --no-cache-dir goprocam)

# Copia il codice
COPY python/goprostream.py python/goprophoto.py ./
COPY .env* ./

CMD ["python", "goprostream.py"]
